rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isRestaurantOwner(restaurantId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
    }

    // Restaurants
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Menu items subcollection
      match /menuItems/{menuItemId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId);
      }

      // Deals subcollection
      match /deals/{dealId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId);
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isRestaurantOwner(restaurantId);
      }
    }

    // Orders (top-level collection)
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.restaurantId is string &&
                       request.resource.data.customerName is string &&
                       request.resource.data.customerPhone is string;
      allow update: if isRestaurantOwner(resource.data.restaurantId);
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
